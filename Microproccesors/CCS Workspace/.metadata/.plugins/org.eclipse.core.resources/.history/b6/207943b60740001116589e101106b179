// Lucas Jones, EELE 371, Final Project Part 7, 04/20/2026
//
// Motor: Adafruit 858, 5VDC, 32-step, 1/16 gearing
//
// Steps per full rotation: 32 * 16 = 512 steps
//
// Reverse (SW2) - max speed:
//   Max RPM = 25 RPM @ 5V
//   Min pulse width = (60s/25RPM) / 512 steps = 0.469ms -> use 0.5ms
//   CCR0 = 499 (SMCLK 1MHz, no divide)
//   Expected time for 1 rotation = 512 * 0.5ms = 256ms
//
// Forward (SW1) - 36 degrees per press:
//   Steps per press = 512 / 10 = 51 steps
//   Target time = 50% of 256ms = 128ms
//   Pulse width = 128ms / 51 = 2.5ms
//   CCR0 = 2499 (SMCLK 1MHz, no divide)
//-----------------------------------------------------

#include <msp430.h>

// step sequence for 4-wire unipolar stepper (single step)
// P3.0 = IN1 (orange), P3.1 = IN2 (pink), P3.2 = IN3 (blue), P3.3 = IN4 (yellow)
const unsigned char stepCW[4]  = {BIT0, BIT1, BIT2, BIT3};  // IN1->IN2->IN3->IN4
const unsigned char stepCCW[4] = {BIT3, BIT2, BIT1, BIT0};  // IN4->IN3->IN2->IN1

volatile int timerFlag = 0;

// UART string send helper
void sendString(const char* str) {
    unsigned int i = 0;
    while(str[i] != '\0') {
        while(!(UCA1IFG & UCTXIFG)){}  // wait for TX buffer ready
        UCA1TXBUF = str[i];
        i++;
    }
    // wait for final byte to fully transmit
    while(!(UCA1IFG & UCTXCPTIFG)){}
    UCA1IFG &= ~UCTXCPTIFG;
}

int main(void)
{
    int i;

    WDTCTL = WDTPW | WDTHOLD;           // stop watchdog timer

    // UART config
    UCA1CTLW0 |= UCSWRST;
    UCA1CTLW0 |= UCSSEL__SMCLK;
    UCA1BRW = 17;
    UCA1MCTLW = 0x4A00;

    // P3.0-P3.3 as outputs for stepper coils
    P3DIR |= BIT0 | BIT1 | BIT2 | BIT3;
    P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);  // all coils off to start

    // SW1 - P4.1
    P4DIR &= ~BIT1;
    P4REN |= BIT1;
    P4OUT |= BIT1;
    P4IES |= BIT1;

    // SW2 - P2.3
    P2DIR &= ~BIT3;
    P2REN |= BIT3;
    P2OUT |= BIT3;
    P2IES |= BIT3;

    // UART pins P4.2, P4.3
    P4SEL1 &= ~(BIT3 | BIT2);
    P4SEL0 |= (BIT3 | BIT2);

    PM5CTL0 &= ~LOCKLPM5;

    UCA1CTLW0 &= ~UCSWRST;

    // Timer B0 config - start with reverse speed (CCR0 = 499 = 0.5ms)
    TB0CTL   = TBCLR;
    TB0CTL  |= TBSSEL__SMCLK;   // 1MHz, no divider needed at these speeds
    TB0CCR0  = 499;              // 0.5ms default (reverse speed)
    TB0CCTL0 = CCIE;

    // enable button IRQs
    P4IFG &= ~BIT1;
    P4IE  |=  BIT1;
    P2IFG &= ~BIT3;
    P2IE  |=  BIT3;

    __enable_interrupt();

    sendString("\r\nMotor control ready.\r\n");

    while(1) {

        // SW1: forward 36 degrees (51 steps, 2.5ms pulse)
        if((P4IN & BIT1) == 0) {
            for(i = 0; i < 10000; i++){}        // debounce
            if((P4IN & BIT1) == 0) {
                while((P4IN & BIT1) == 0){}     // wait for release

                TB0CCR0 = 2499;                 // 2.5ms pulse width

                for(i = 0; i < 51; i++) {
                    // apply step
                    P3OUT = (P3OUT & 0xF0) | stepCW[i % 4];
                    // wait one pulse period
                    timerFlag = 0;
                    TB0CTL |= MC__UP;
                    while(timerFlag == 0){}
                    TB0CTL &= ~MC__UP;
                    TB0CTL |= TBCLR;
                }
                P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);  // de-energize coils

                sendString("Motor advanced 36 degrees.\r\n");
            }
        }

        // SW2: reverse 1 full rotation (512 steps, 0.5ms pulse)
        if((P2IN & BIT3) == 0) {
            for(i = 0; i < 10000; i++){}        // debounce
            if((P2IN & BIT3) == 0) {
                while((P2IN & BIT3) == 0){}     // wait for release

                TB0CCR0 = 499;                  // 0.5ms pulse width

                for(i = 0; i < 512; i++) {
                    P3OUT = (P3OUT & 0xF0) | stepCCW[i % 4];
                    timerFlag = 0;
                    TB0CTL |= MC__UP;
                    while(timerFlag == 0){}
                    TB0CTL &= ~MC__UP;
                    TB0CTL |= TBCLR;
                }
                P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);  // de-energize coils

                sendString("Motor reversed 1 rotation.\r\n");
            }
        }
    }

    return 0;
}

//-----------------------------------------------------
// ISRs
//-----------------------------------------------------
#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer_B0_ISR(void) {
    timerFlag = 1;
}

#pragma vector = PORT4_VECTOR
__interrupt void ISR_Port4_S1(void) {
    P4IFG &= ~BIT1;
}

#pragma vector = PORT2_VECTOR
__interrupt void ISR_Port2_S2(void) {
    P2IFG &= ~BIT3;
}
