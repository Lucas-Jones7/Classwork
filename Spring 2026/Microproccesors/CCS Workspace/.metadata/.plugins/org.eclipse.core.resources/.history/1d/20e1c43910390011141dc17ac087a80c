//
// Timer Configuration:
//   SMCLK = 1,000,000 Hz
//   ID__4 = divide by 4 = 250,000 Hz
//   TBIDEX__4 = divide by 4 = 62,500 Hz
//   CCR0 = 15624 = 0.25s
//   (62,500 / 15,625 = 4 Hz = 0.25s period)
//-----------------------------------------------------
#include <msp430.h>

volatile int timerFlag = 0;

int main(void)
{
    int i, j;

    WDTCTL = WDTPW | WDTHOLD;          // stop watchdog timer

    // Config 4 LEDs on P3.0-P3.3, LSBit (BIT0) starts ON
    P3DIR |= BIT0 | BIT1 | BIT2 | BIT3;
    P3OUT &= ~(BIT1 | BIT2 | BIT3);
    P3OUT |= BIT0;                      // LSBit ON

    // Config SW1 = P4.1 as input with pull-up
    P4DIR &= ~BIT1;
    P4REN |= BIT1;
    P4OUT |= BIT1;

    // Config SW2 = P2.3 as input with pull-up
    P2DIR &= ~BIT3;
    P2REN |= BIT3;
    P2OUT |= BIT3;

    // Unlock GPIO
    PM5CTL0 &= ~LOCKLPM5;

    // Config Timer TB0 for 0.25s using SMCLK
    TB0CTL   = TBCLR;                   // clear timer and dividers
    TB0CTL  |= TBSSEL__SMCLK;           // SMCLK source
    TB0CTL  |= ID__4;                   // divide by 4
    TB0EX0   = TBIDEX__4;               // divide by 4 again
    TB0CCR0  = 15624;                   // 62500 * 0.25 - 1 = 15624
    TB0CCTL0 = CCIE;                    // enable CCR0 interrupt

    __enable_interrupt();

    // LED patterns: clockwise and counterclockwise
    unsigned char cw[4]  = {BIT0, BIT1, BIT2, BIT3};
    unsigned char ccw[4] = {BIT3, BIT2, BIT1, BIT0};

    // -----------------------------------------------
    // First infinite loop: wait for SW1
    // -----------------------------------------------
    while(1) {
        if((P4IN & BIT1) == 0) {        // SW1 pressed (active low)
            for(i = 0; i < 10000; i++){} // debounce delay
            if((P4IN & BIT1) == 0) {
                break;
            }
        }
    }

    // 3 clockwise loops = 12 flashes
    for(i = 0; i < 12; i++) {
        P3OUT = (P3OUT & 0xF0) | cw[i % 4];
        // 0.25s timer delay
        timerFlag = 0;
        TB0CTL |= MC__UP;
        while(timerFlag == 0){}
        TB0CTL &= ~MC__UP;
        TB0CTL |= TBCLR;
    }
    P3OUT = (P3OUT & 0xF0) | BIT0;     // return LSBit ON

    // -----------------------------------------------
    // Second infinite loop: wait for SW2
    // -----------------------------------------------
    while(1) {
        if((P2IN & BIT3) == 0) {        // SW2 pressed (active low)
            for(i = 0; i < 10000; i++){} // debounce delay
            if((P2IN & BIT3) == 0) {
                break;
            }
        }
    }

    // 2 counterclockwise loops = 8 flashes
    for(i = 0; i < 8; i++) {
        P3OUT = (P3OUT & 0xF0) | ccw[i % 4];
        // 0.25s timer delay
        timerFlag = 0;
        TB0CTL |= MC__UP;
        while(timerFlag == 0){}
        TB0CTL &= ~MC__UP;
        TB0CTL |= TBCLR;
    }
    P3OUT = (P3OUT & 0xF0) | BIT0;     // return LSBit ON

    // Final infinite loop
    while(1){}

    return 0;
}

// Timer B0 CCR0 ISR
#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer_B0_ISR(void) {
    timerFlag = 1;
}
