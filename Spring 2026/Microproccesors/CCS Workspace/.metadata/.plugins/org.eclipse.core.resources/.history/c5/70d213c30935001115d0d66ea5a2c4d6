//
// Voltage Range Thresholds:
// DN = (V * 4095 / 3.3) - offset
// DC offset = 15 DN
// low:     0    - 605  (0V   - 0.5V)
// mid:     606  - 1350 (0.5V - 1.1V)
// high:    1351 - 2714 (1.1V - 2.2V)
// extreme: 2715 - 3708 (2.2V - 3.0V)
//-----------------------------------------------------
#include <msp430.h>

// global variables
volatile unsigned int ADCvalue = 0;
#define OFFSET   15
#define LOW_MAX  (636  - OFFSET)    // 605
#define MID_MAX  (1365 - OFFSET)    // 1350
#define HIGH_MAX (2729 - OFFSET)    // 2714

int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;      // stop watchdog timer

    // configure LEDs
    P1DIR |= BIT0;                  // config LED1 as output
    P1OUT &= ~BIT0;                 // LED1 off to start
    P6DIR |= BIT6;                  // config LED2 as output
    P6OUT &= ~BIT6;                 // LED2 off to start

    // configure P1.2 as ADC input
    P1SEL1 |= BIT2;                 // configure P1.2 to ADC function
    P1SEL0 |= BIT2;

    // turn on GPIO
    PM5CTL0 &= ~LOCKLPM5;          // enable GPIO

    // configure ADC
    ADCCTL0 &= ~ADCSHT;            // clear ADCSHT from default
    ADCCTL0 |= ADCSHT_2;           // conversion cycles = 16
    ADCCTL0 |= ADCON;              // turn ADC on
    ADCCTL1 |= ADCSSEL_2;          // ADC clock source = SMCLK
    ADCCTL1 |= ADCSHP;             // sample signal source = sampling timer
    ADCCTL2 &= ~ADCRES;            // clear ADCRES from default
    ADCCTL2 |= ADCRES_2;           // was ADCRES, ADCRES_2 = 12-bit
    ADCMCTL0 |= ADCINCH_2;         // ADC input channel = A2 (P1.2)
    ADCIE |= ADCIE0;               // enable ADC conversion complete IRQ

    __enable_interrupt();           // enable global interrupts

    // ----------------- MAIN LOOP ---------------------------------
    while(1)
    {
        ADCCTL0 |= ADCENC | ADCSC; // enable and start conversion
        __bis_SR_register(LPM0_bits);

        // control LEDs based on ADC value
        if(ADCvalue <= LOW_MAX){
            // low range: LED1 off, LED2 off
            P1OUT &= ~BIT0;
            P6OUT &= ~BIT6;
        } else if(ADCvalue <= MID_MAX){
            // mid range: LED1 off, LED2 on
            P1OUT &= ~BIT0;
            P6OUT |= BIT6;
        } else if(ADCvalue <= HIGH_MAX){
            // high range: LED1 on, LED2 off
            P1OUT |= BIT0;
            P6OUT &= ~BIT6;
        } else {
            // extreme range: LED1 on, LED2 on
            P1OUT |= BIT0;
            P6OUT |= BIT6;
        }
    }

    return 0;
}

//-----------------------------------------------------
// Interrupt Service Routines
//-----------------------------------------------------
#pragma vector = ADC_VECTOR
__interrupt void ADC_ISR(void){
    ADCvalue = ADCMEM0;                     // store ADC result
    __bic_SR_register_on_exit(LPM0_bits);   // wake up main loop
}
