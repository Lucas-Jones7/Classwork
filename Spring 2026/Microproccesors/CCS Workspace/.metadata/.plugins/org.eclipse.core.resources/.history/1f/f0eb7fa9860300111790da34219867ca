;-------------------------------------------------------------------------------
; MSP430 Assembler Code Template for use with TI Code Composer Studio
; Lucas Jones, EELE 371, Lab 7.3, 02/06/2026
;
;-------------------------------------------------------------------------------
            .cdecls C,LIST,"msp430.h"       ; Include device header file
            
;-------------------------------------------------------------------------------
            .def    RESET                   ; Export program entry-point to
                                            ; make it known to linker.
;-------------------------------------------------------------------------------
            .text                           ; Assemble into program memory.
            .retain                         ; Override ELF conditional linking
                                            ; and retain current section.
            .retainrefs                     ; And retain any sections that have
                                            ; references to current section.

;-------------------------------------------------------------------------------
RESET       mov.w   #__STACK_END,SP         ; Initialize stackpointer
StopWDT     mov.w   #WDTPW|WDTHOLD,&WDTCTL  ; Stop watchdog timer


;-------------------------------------------------------------------------------
; Main loop here
;-------------------------------------------------------------------------------

; Lab 7.3 - Step 2: Prepare the main.asm file
init:
; Lab 7.3 - Step 3: Initialize Register Values
			mov.w	#0000h, R4
			mov.w 	#0FFFFh, R5
			mov.w	#0F0F0h, R6
			mov.w	#0BEEFh, R7
			mov.w	#0DEEDh, R8
			mov.w	#0ECEh, R9
			mov.w	#0000h, R10
			mov.w	#1000h, R11

main:
; Lab 7.3 - Step 3: Using Rotate instructions to move the locations of a bit within a word
			clrc							; clrc clears the Carry Flag so we have a known starting point for these examples
			rlc.w 	R11						; rotates left arithmitically
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11
			rlc.w 	R11


			rrc.w	R11						; rotates right arithmitecally
			rrc.w	R11
			rrc.w	R11
			rrc.w	R11
			rrc.w	R11
			rrc.w	R11
			rrc.w	R11
			rrc.w	R11

			jmp		main

;-------------------------------------------------------------------------------
; Stack Pointer definition
;-------------------------------------------------------------------------------
            .global __STACK_END
            .sect   .stack
            
;-------------------------------------------------------------------------------
; Interrupt Vectors
;-------------------------------------------------------------------------------
            .sect   ".reset"                ; MSP430 RESET Vector
            .short  RESET
            
