//
// Timer Configuration:
//   SMCLK = 1,000,000 Hz
//   ID__4 = divide by 4 = 250,000 Hz
//   TBIDEX__4 = divide by 4 = 62,500 Hz
//   CCR0 = 15624 = period = 0.25s
//   (62,500 / 15,625 = 4 Hz = 0.25s period)
//-----------------------------------------------------

#include <msp430.h> 

// global vars
volatile int timerFlag = 0;
char FirstName[] = "Forward ";
char FullName[] = "Forward Reverse "; // space at end acts as separator in terminal
unsigned int position;
unsigned int sendingLast = 0; // 0 = send first name, 1 = send last name

int main(void)
{
	WDTCTL = WDTPW | WDTHOLD;	// stop watchdog timer
	
// ------------------------------ MAIN LOOP ----------------------------------------
	while(1) {
	    // Reset LSBit ON at start of each cycle
	    P3OUT = (P3OUT & 0xF0) | BIT0;
	    // Wait for SW1 press
	    while(1) {
	        if((P4IN & BIT1) == 0) {
	            for(i = 0; i < 10000; i++){}    // debounce delay
	            if((P4IN & BIT1) == 0) break;
	        }
	    }
	    while((P4IN & BIT1) == 0){}            // wait for SW1 release
	    // S1: 3 clockwise loops = 12 flashes
	    for(i = 0; i < 12; i++) {
	        P3OUT = (P3OUT & 0xF0) | cw[i % 4];
	        timerFlag = 0;
	        TB0CTL |= MC__UP;
	        while(timerFlag == 0){}
	        TB0CTL &= ~MC__UP;
	        TB0CTL |= TBCLR;
	    }
	    P3OUT = (P3OUT & 0xF0) | BIT0;         // return LSBit ON
	    // Wait for SW2, but if SW1 pressed again repeat CW flashes
	    while(1) {
	        if((P2IN & BIT3) == 0) {
	            for(i = 0; i < 10000; i++){}    // debounce delay
	            if((P2IN & BIT3) == 0) break;   // SW2 pressed, exit to CCW
	        }
	        if((P4IN & BIT1) == 0) {
	            for(i = 0; i < 10000; i++){}    // debounce delay
	            if((P4IN & BIT1) == 0) {
	                while((P4IN & BIT1) == 0){}  // wait for SW1 release
	                // repeat CW flashes
	                for(i = 0; i < 12; i++) {
	                    P3OUT = (P3OUT & 0xF0) | cw[i % 4];
	                    timerFlag = 0;
	                    TB0CTL |= MC__UP;
	                    while(timerFlag == 0){}
	                    TB0CTL &= ~MC__UP;
	                    TB0CTL |= TBCLR;
	                }
	                P3OUT = (P3OUT & 0xF0) | BIT0;  // return LSBit ON
	            }
	        }
	    }
	    while((P2IN & BIT3) == 0){}            // wait for SW2 release
	    // S2: 2 counterclockwise loops = 8 flashes
	    for(i = 0; i < 8; i++) {
	        P3OUT = (P3OUT & 0xF0) | ccw[i % 4];
	        timerFlag = 0;
	        TB0CTL |= MC__UP;
	        while(timerFlag == 0){}
	        TB0CTL &= ~MC__UP;
	        TB0CTL |= TBCLR;
	    }
	    P3OUT = (P3OUT & 0xF0) | BIT0;         // return LSBit ON
	    // Wait for SW1, but if SW2 pressed again repeat CCW flashes
	    while(1) {
	        if((P4IN & BIT1) == 0) {
	            for(i = 0; i < 10000; i++){}    // debounce delay
	            if((P4IN & BIT1) == 0) break;   // SW1 pressed, exit to top
	        }
	        if((P2IN & BIT3) == 0) {
	            for(i = 0; i < 10000; i++){}    // debounce delay
	            if((P2IN & BIT3) == 0) {
	                while((P2IN & BIT3) == 0){}  // wait for SW2 release
	                // repeat CCW flashes
	                for(i = 0; i < 8; i++) {
	                    P3OUT = (P3OUT & 0xF0) | ccw[i % 4];
	                    timerFlag = 0;
	                    TB0CTL |= MC__UP;
	                    while(timerFlag == 0){}
	                    TB0CTL &= ~MC__UP;
	                    TB0CTL |= TBCLR;
	                }
	                P3OUT = (P3OUT & 0xF0) | BIT0;  // return LSBit ON
	            }
	        }
	    }
	    while((P4IN & BIT1) == 0){}            // wait for SW1 release
	}
	return 0;
}

//-----------------------------------------------------
// Interrupt Service Routines
//-----------------------------------------------------
// service s1 press
#pragma vector = PORT4_VECTOR
__interrupt void ISR_Port4_S1(void)
{
    position = 0;
    sendingLast = 0;

    UCA1IE |= UCTXCPTIE;            // enable TX-complete IRQ
    UCA1IFG &= ~UCTXCPTIFG;         // clear TX-complete flag
    UCA1TXBUF = FirstName[position]; // load first character

    P4IFG &= ~BIT1;                 // clear port flag
}
// ----------------------- END S1 ISR -------------------------

// service s2 press
#pragma vector = PORT2_VECTOR
__interrupt void ISR_Port2_S2(void)
{
// last name "Jones" starts at sizeof(FirstName) in FullName
    position = sizeof(FirstName) - 1;
    sendingLast = 1;

    UCA1IE |= UCTXCPTIE;
    UCA1IFG &= ~UCTXCPTIFG;
    UCA1TXBUF = FullName[position];

    P2IFG &= ~BIT3;                 // clear port flag
}
// ----------------------- END S2 ISR  ------------------------

// service UART tx
#pragma vector = USCI_A1_VECTOR
__interrupt void ISR_EUSCI_A1(void)
{
    unsigned int stopIndex;

    if (sendingLast == 0)
        stopIndex = sizeof(FirstName); // send indices 0 to sizeof(FirstName)-1
    else
        stopIndex = sizeof(FullName); // send indices sizeof(FirstName) to sizeof(FullName)-1

    if (position == stopIndex)
    {
        UCA1IE &= ~UCTXCPTIE;       // all chars sent disable TX interrupt
    }
    else
    {
        position++;
        UCA1TXBUF = (sendingLast == 0) ? FirstName[position] : FullName[position];
    }

    UCA1IFG &= ~UCTXCPTIFG;         // clear TX-complete flag
}

// ------------------ END UART ISR ---------------------------------

// service timer B0
#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer_B0_ISR(void) {
    timerFlag = 1;
}

// -------------------- END TB0 ISR --------------------------------
