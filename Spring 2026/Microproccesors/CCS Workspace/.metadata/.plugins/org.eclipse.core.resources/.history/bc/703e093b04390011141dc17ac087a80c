#include <msp430.h> 

//global vars
int S1;
int S2;
int S1Loops = 12;
int S2Loops = 8;

int main(void)
{
	WDTCTL = WDTPW | WDTHOLD;	// stop watchdog timer
	
	// config 4 leds to p3.0-p3.3 nibble
	P3DIR |= BIT0 | BIT1 | BIT2 | BIT3;
	P3OUT &= ~(BIT0 | BIT1 | BIT2); // all except LSB start off
	P3OUT |= BIT3;                  // LSBit start on

	// config s1 and s2 as inputs
	P4DIR &= ~BIT1;             // S1 as input
	P4REN |= BIT1;              // Enable resistor on S1
	P4OUT |= BIT1;              // Set as pull-UP
	P4IES |= BIT1;               // high-to-low edge

	P2DIR &= ~BIT3;             // S2 as input
	P2REN |= BIT3;              // Enable resostor on S2
	P2OUT |= BIT3;              // Set as pull-UP
	P2IES |= BIT3;               // high-to-low edge

	// turn of gpio
	PM5CTL0 &= ~LOCKLPM5;

	// config IRQ
	P4IFG &= ~BIT1;              // clear flag
	P4IE  |= BIT1;               // enable interrupt
	P2IFG &= ~BIT3;              // clear flag
	P2IE  |= BIT3;               // enable interrupt
	__enable_interrupt();        // enable maskable interrupts

// ----------------------- MAIN LOOP -------------------------
	while(1){
	    S1 = P4IN;               // read p4 to S1 var
	    S1 &= BIT1;              // clears bits in S1except bit 1
	    if(S1 == 0){
	        while(S1Loops > 0){
	            P3OUT >> 1;
	            S1Loops--;
	        }
	    }
	    S2 = P2IN;               // read p4 to S1 var
	    S2 &= BIT3;              // clears bits in S1except bit 1
	    if(S2 == 0){
	        while(S2Loops > 0){
	            P3OUT << 1;
	            S2Loops--;
	        }
	    }

	}
	return 0;
}

//-----------------------------------------------------
// Interrupt Service Routines
//-----------------------------------------------------
// service s1
#pragma vector = PORT4_VECTOR
__interrupt void PORT4_ISR(void){
    S1Pressed = 1;           // set flag for main loop
    P4IFG &= ~BIT1;              // clear S1 flag
}

// --------------------------------- END SERVICE S1 ----------------------------------

// service s2
#pragma vector = PORT2_VECTOR
__interrupt void PORT2_ISR(void){
    S2Pressed = 1;           // set flag for main loop
    P2IFG &= ~BIT3;              // clear S2 flag
}

// --------------------------------- END SERVICE S2 ----------------------------------
