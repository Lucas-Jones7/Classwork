// Lucas Jones, EELE 371, Final Project Challenge 8, 04/20/2026
//
// ADC pin assingment: P1.4
// Voltage Range Thresholds:
//    Safe Range: 0 - 25lbs gives 5lbs warning window before leaving ideal operating range
//                = 0mv - (40mv * (25))
//                = 0mv - 1000mv
//                = 0 - 1v
//
//    Warning Range: 25 - 40lbs gives 15lbs warning window before entering unsafe operating range
//                = 1000mv - (40mv * (40))
//                = 1000mv - 1600mv
//                = 1v - 1.6v
//
//    Unsafe Range: 40 - 50lbs gives 10lbs warning window before reaching maximum operating lbs
//                = 1600mv - (40mv * (50))
//                = 1600mv - 2000mv
//                = 1.6v - 2v
//
//    DC offset = 15 DN
//    LOW_MAX(1v) = (1 * 4095 / 3.3) - 15 = 1226
//    HIGH_MAX(1.6v) = (1.6 * 4095 / 3.3) - 15 = 1971
//
// Motor config:
// Steps per full rotation: 32 * 16 = 512 steps
//
// Reverse (SW2) - max speed:
//   Max RPM = 25 RPM @ 5V
//   Min pulse width = (60s/25RPM) / 512 steps = 0.469ms -> use 0.5ms
//   SMCLK / ID__4 / TBIDEX__4 = 62,500 Hz
//   CCR0 = 31 (62,500 * 0.0005 = 31.25 -> 31)
//   Expected time for 1 rotation = 512 * 0.5ms = 256ms
//
// Forward (SW1) - 36 degrees per press:
//   Steps per press = 512 / 10 = 51 steps
//   Target time = 50% of 256ms = 128ms
//   Pulse width = 128ms / 51 = 2.5ms
//   CCR0 = 156 (62,500 * 0.0025 = 156.25 -> 156)
//
//-----------------------------------------------------

#include <msp430.h>

//RTC INIT time (CHANGE BEFORE DEMO SILLY GOOSE)
#define START_REG   0x03
#define SEC_INIT    0x00
#define MIN_INIT    0x24
#define HOUR_INIT   0x06
#define DAY_INIT    0x26
#define WDAY_INIT   0x00
#define MONTH_INIT  0x04
#define YEAR_INIT   0x26

// tx packet for RTC init
unsigned char txPacket[8] = {
    START_REG, SEC_INIT, MIN_INIT, HOUR_INIT,
    DAY_INIT, WDAY_INIT, MONTH_INIT, YEAR_INIT
};

// ADC thresholds
#define OFFSET   15
#define LOW_MAX  (1226 - OFFSET)    // 1v
#define HIGH_MAX (1971 - OFFSET)    // 1.6v

// global vars
volatile int txIndex        = 0;
volatile int rxIndex        = 0;
volatile int doingTxInit    = 0;
volatile unsigned char rxBuffer[2]        = {0, 0};
volatile unsigned char timestamp_seconds  = 0;
volatile unsigned char timestamp_minutes  = 0;
volatile unsigned int ADCvalue = 0;
volatile int timerFlag = 0;

// UART messages for motor actions
char revMsg[]    = "Motor reversed 1 rotation.\r\n";
char fwdMsg[]    = "Motor advanced 1 step.\r\n";

// UART messages for timestamp header
char tsHdrMsg[]  = "Unsafe! Timestamp (MM:SS) -> ";
unsigned int  position   = 0;
unsigned int  msgLen     = 0;
volatile unsigned int sending = 0;
char* currentMsg;

// step sequences
const unsigned char stepCCW[4] = {BIT0, BIT1, BIT2, BIT3};
const unsigned char stepCW[4]  = {BIT3, BIT2, BIT1, BIT0};

// threshold crossing flag: 1 = was already in unsafe zone, 0 = was safe/warning
volatile int wasUnsafe = 0;

//-----------------------------------------------------
// Helper: send a null-terminated string via UART (blocking)
//-----------------------------------------------------
void sendString(char* msg, unsigned int len)
{
    currentMsg = msg;
    position   = 0;
    msgLen     = len;
    sending    = 1;
    UCA1IE    |= UCTXCPTIE;
    UCA1IFG   &= ~UCTXCPTIFG;
    UCA1TXBUF  = currentMsg[position];
    while(sending){}
}

//-----------------------------------------------------
// Helper: send one byte via UART with small delay (blocking, no ISR)
// Used for BCD timestamp digits per assignment note
//-----------------------------------------------------
void sendByteDelay(unsigned char b)
{
    int i;
    while(!(UCA1IFG & UCTXIFG)){}  // wait for TX buffer ready
    UCA1TXBUF = b;
    for(i = 0; i < 500; i++){}
}

//-----------------------------------------------------
// Helper: read ADC, update LEDs, optionally send RTC timestamp
// Returns 1 if unsafe zone, 0 otherwise
//-----------------------------------------------------
void doADCandRTC(void)
{
    // trigger ADC conversion (ISR wakes us from LPM0)
    ADCCTL0 |= ADCENC | ADCSC;
    __bis_SR_register(LPM0_bits);

    // update LEDs based on ADC reading
    if(ADCvalue < LOW_MAX){
        // SAFE: LED2 on, LED1 off
        P1OUT &= ~BIT0;
        P6OUT |=  BIT6;

        wasUnsafe = 0;  // back in safe zone, reset crossing flag

    } else if(ADCvalue > HIGH_MAX){
        // UNSAFE: LED1 on, LED2 off
        P1OUT |=  BIT0;
        P6OUT &= ~BIT6;

        // only read and send RTC timestamp on the crossing into unsafe zone
        if(wasUnsafe == 0){
            wasUnsafe = 1;

            // --- read RTC: send register pointer (0x03 = seconds register) ---
            rxIndex     = 0;
            UCB0TBCNT   = 0x01;
            doingTxInit = 0;
            UCB0CTLW0  |= UCTR;
            UCB0CTLW0  |= UCTXSTT;
            while((UCB0IFG & UCSTPIFG) == 0){}
            UCB0IFG &= ~UCSTPIFG;

            // --- read 2 bytes: seconds (rxBuffer[0]), minutes (rxBuffer[1]) ---
            UCB0TBCNT   = 0x02;
            UCB0CTLW0  &= ~UCTR;
            UCB0CTLW0  |=  UCTXSTT;
            while((UCB0IFG & UCSTPIFG) == 0){}
            UCB0IFG &= ~UCSTPIFG;

            timestamp_seconds = rxBuffer[0];
            timestamp_minutes = rxBuffer[1];

            // --- send timestamp header via UART ---
            sendString(tsHdrMsg, sizeof(tsHdrMsg) - 1);

            // disable TX-complete IRQ before direct byte sends
            UCA1IE &= ~UCTXCPTIE;

            // --- send minutes (BCD, two digits) ---
            sendByteDelay(((timestamp_minutes & 0xF0) >> 4) + '0');
            sendByteDelay( (timestamp_minutes & 0x0F)       + '0');

            // colon separator
            sendByteDelay(':');

            // --- send seconds (BCD, two digits) per assignment snippet ---
            sendByteDelay(((timestamp_seconds & 0xF0) >> 4) + '0');
            sendByteDelay( (timestamp_seconds & 0x0F)       + '0');

            sendByteDelay('\r');
            sendByteDelay('\n');

            // clear any flag set during direct sends
            UCA1IFG &= ~UCTXCPTIFG;
        }

    } else {
        // WARNING: both LEDs off
        P1OUT &= ~BIT0;
        P6OUT &= ~BIT6;

        wasUnsafe = 0;  // back in safe/warning zone, reset crossing flag
    }
}

// ----------------------------------------- MAIN -----------------------------------------
int main(void)
{
    int i;

    WDTCTL = WDTPW | WDTHOLD;  // stop watchdog timer

    //-----------------------------------------------------
    // Configure I2C (UCB0) - from Challenge 6
    //-----------------------------------------------------
    UCB0CTLW0 |= UCSWRST;
    UCB0CTLW0 |= UCSSEL__SMCLK;
    UCB0BRW    = 10;
    UCB0CTLW0 |= UCMODE_3;
    UCB0CTLW0 |= UCMST;
    UCB0I2CSA  = 0x0068;
    UCB0CTLW1 |= UCASTP_2;

    // I2C pins: P1.3 = SCL, P1.2 = SDA
    P1SEL1 &= ~BIT3;  P1SEL0 |= BIT3;
    P1SEL1 &= ~BIT2;  P1SEL0 |= BIT2;

    //-----------------------------------------------------
    // Configure LEDs - from Challenge 6
    //-----------------------------------------------------
    P1DIR |= BIT0;   P1OUT &= ~BIT0;   // LED1 off
    P6DIR |= BIT6;   P6OUT &= ~BIT6;   // LED2 off

    //-----------------------------------------------------
    // Configure ADC pin P1.4 - from Challenge 6
    //-----------------------------------------------------
    P1SEL1 |= BIT4;
    P1SEL0 |= BIT4;

    //-----------------------------------------------------
    // Configure UART (UCA1) - from Challenge 7
    //-----------------------------------------------------
    UCA1CTLW0 |= UCSWRST;
    UCA1CTLW0 |= UCSSEL__SMCLK;
    UCA1BRW    = 17;
    UCA1MCTLW  = 0x4A00;

    // UART pins: P4.2 = RX, P4.3 = TX
    P4SEL1 &= ~(BIT3 | BIT2);
    P4SEL0 |=  (BIT3 | BIT2);

    //-----------------------------------------------------
    // Configure stepper motor pins P3.0-P3.3 - from Challenge 7
    //-----------------------------------------------------
    P3DIR |= BIT0 | BIT1 | BIT2 | BIT3;
    P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);

    //-----------------------------------------------------
    // Configure SW1 (P4.1) and SW2 (P2.3) - from Challenge 7
    //-----------------------------------------------------
    P4DIR &= ~BIT1;  P4REN |= BIT1;  P4OUT |= BIT1;  P4IES |= BIT1;
    P2DIR &= ~BIT3;  P2REN |= BIT3;  P2OUT |= BIT3;  P2IES |= BIT3;

    //-----------------------------------------------------
    // Disable high-impedance (unlock GPIO)
    //-----------------------------------------------------
    PM5CTL0 &= ~LOCKLPM5;

    //-----------------------------------------------------
    // Take peripherals out of software reset
    //-----------------------------------------------------
    UCB0CTLW0 &= ~UCSWRST;
    UCA1CTLW0 &= ~UCSWRST;

    //-----------------------------------------------------
    // Configure ADC - from Challenge 6
    //-----------------------------------------------------
    ADCCTL0 &= ~ADCSHT;
    ADCCTL0 |=  ADCSHT_2;
    ADCCTL0 |=  ADCON;
    ADCCTL1 |=  ADCSSEL_2;
    ADCCTL1 |=  ADCSHP;
    ADCCTL2 &= ~ADCRES;
    ADCCTL2 |=  ADCRES_2;
    ADCMCTL0 |= ADCINCH_4;
    ADCIE    |= ADCIE0;

    //-----------------------------------------------------
    // Configure Timer B0 - from Challenge 7
    //-----------------------------------------------------
    TB0CTL   = TBCLR;
    TB0CTL  |= TBSSEL__SMCLK;
    TB0CTL  |= ID__4;
    TB0EX0   = TBIDEX__4;
    TB0CCR0  = 156;
    TB0CCTL0 = CCIE;

    //-----------------------------------------------------
    // Enable I2C TX/RX IRQs - from Challenge 6
    //-----------------------------------------------------
    UCB0IE |= UCTXIE0;
    UCB0IE |= UCRXIE0;

    //-----------------------------------------------------
    // Enable button IRQs - from Challenge 7
    //-----------------------------------------------------
    P4IFG &= ~BIT1;  P4IE |= BIT1;
    P2IFG &= ~BIT3;  P2IE |= BIT3;

    __enable_interrupt();

    //-----------------------------------------------------
    // Write initial time to RTC - from Challenge 6
    //-----------------------------------------------------
    UCB0TBCNT   = 0x08;
    txIndex     = 0;
    doingTxInit = 1;
    UCB0CTLW0  |= UCTR;
    UCB0CTLW0  |= UCTXSTT;
    while((UCB0IFG & UCSTPIFG) == 0){}
    UCB0IFG &= ~UCSTPIFG;

    //-----------------------------------------------------
    // Main loop
    //-----------------------------------------------------
    while(1){

        //--------------------------------------------------
        // SW1: forward 36 degrees (51 steps CW, 2.5ms pulse)
        //--------------------------------------------------
        if((P4IN & BIT1) == 0){
            for(i = 0; i < 10000; i++){}        // debounce
            if((P4IN & BIT1) == 0){
                while((P4IN & BIT1) == 0){}     // wait for release

                TB0CCR0 = 156;                  // 2.5ms pulse width

                for(i = 0; i < 51; i++){
                    P3OUT = (P3OUT & 0xF0) | stepCW[i % 4];
                    timerFlag = 0;
                    TB0CTL |= MC__UP;
                    while(timerFlag == 0){}
                    TB0CTL &= ~MC__UP;
                    TB0CTL |= TBCLR;
                }
                P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);

                // send motor UART message
                sendString(fwdMsg, sizeof(fwdMsg) - 1);

                // ADC read + LED update + RTC timestamp if newly unsafe
                doADCandRTC();
            }
        }

        //--------------------------------------------------
        // SW2: reverse 1 full rotation (512 steps CCW, 2.5ms pulse)
        //--------------------------------------------------
        if((P2IN & BIT3) == 0){
            for(i = 0; i < 10000; i++){}        // debounce
            if((P2IN & BIT3) == 0){
                while((P2IN & BIT3) == 0){}     // wait for release

                TB0CCR0 = 156;                  // 2.5ms pulse width

                for(i = 0; i < 512; i++){
                    P3OUT = (P3OUT & 0xF0) | stepCCW[i % 4];
                    timerFlag = 0;
                    TB0CTL |= MC__UP;
                    while(timerFlag == 0){}
                    TB0CTL &= ~MC__UP;
                    TB0CTL |= TBCLR;
                }
                P3OUT &= ~(BIT0 | BIT1 | BIT2 | BIT3);

                // send motor UART message
                sendString(revMsg, sizeof(revMsg) - 1);

                // ADC read + LED update + RTC timestamp if newly unsafe
                doADCandRTC();
            }
        }
    }

    return 0;
}

//-----------------------------------------------------
// ISR: ADC conversion complete - from Challenge 6
//-----------------------------------------------------
#pragma vector = ADC_VECTOR
__interrupt void ADC_ISR(void){
    ADCvalue = ADCMEM0;
    __bic_SR_register_on_exit(LPM0_bits);   // wake main loop
}

//-----------------------------------------------------
// ISR: I2C (UCB0) TX/RX - from Challenge 6
//-----------------------------------------------------
#pragma vector = EUSCI_B0_VECTOR
__interrupt void EUSCI_B0_ISR(void)
{
    switch(UCB0IV)
    {
        case 0x16:                          // RXIFG0
            rxBuffer[rxIndex] = UCB0RXBUF;
            rxIndex++;
            break;
        case 0x18:                          // TXIFG0
            if(doingTxInit){
                UCB0TXBUF = txPacket[txIndex];
                txIndex++;
            } else {
                UCB0TXBUF = START_REG;      // register pointer
            }
            break;
        default:
            break;
    }
}

//-----------------------------------------------------
// ISR: UART TX complete (UCA1) - from Challenge 7
//-----------------------------------------------------
#pragma vector = USCI_A1_VECTOR
__interrupt void ISR_EUSCI_A1(void)
{
    position++;
    if(position == msgLen){
        UCA1IE &= ~UCTXCPTIE;
        sending = 0;
    } else {
        UCA1TXBUF = currentMsg[position];
    }
    UCA1IFG &= ~UCTXCPTIFG;
}

//-----------------------------------------------------
// ISR: Timer B0 - from Challenge 7
//-----------------------------------------------------
#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer_B0_ISR(void){
    timerFlag = 1;
}

//-----------------------------------------------------
// ISR: SW1 (P4.1) - from Challenge 7
//-----------------------------------------------------
#pragma vector = PORT4_VECTOR
__interrupt void ISR_Port4_S1(void){
    P4IFG &= ~BIT1;
}

//-----------------------------------------------------
// ISR: SW2 (P2.3) - from Challenge 7
//-----------------------------------------------------
#pragma vector = PORT2_VECTOR
__interrupt void ISR_Port2_S2(void){
    P2IFG &= ~BIT3;
}
