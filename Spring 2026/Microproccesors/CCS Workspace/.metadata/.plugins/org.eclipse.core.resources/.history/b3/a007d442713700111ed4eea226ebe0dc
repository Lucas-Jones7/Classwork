#include <msp430.h>

//-----------------------------------------------------
// RTC Initial Time (Class start: 10:00:00, April 13, 2026)
//-----------------------------------------------------
#define START_REG   0x03
#define SEC_INIT    0x00
#define MIN_INIT    0x00
#define HOUR_INIT   0x10
#define DAY_INIT    0x13
#define WDAY_INIT   0x01
#define MONTH_INIT  0x04
#define YEAR_INIT   0x26

// TX packet: register address + 7 time/date bytes
unsigned char txPacket[8] = {
    START_REG, SEC_INIT, MIN_INIT, HOUR_INIT,
    DAY_INIT, WDAY_INIT, MONTH_INIT, YEAR_INIT
};

// Global variables (ISRs must be outside main)
volatile int txIndex        = 0;
volatile int rxIndex        = 0;
volatile int buttonPressed  = 0;
volatile int doingTxInit    = 0;    // 1 = writing init, 0 = writing reg pointer
volatile unsigned char rxBuffer[2]        = {0, 0};
volatile unsigned char timestamp_seconds  = 0;
volatile unsigned char timestamp_minutes  = 0;

//-----------------------------------------------------
// ISRs must live outside main — unavoidable in C
//-----------------------------------------------------
#pragma vector = EUSCI_B0_VECTOR
__interrupt void EUSCI_B0_ISR(void)
{
    switch(UCB0IV)
    {
        case 0x16:                          // RXIFG0
            rxBuffer[rxIndex] = UCB0RXBUF;
            rxIndex++;
            break;
        case 0x18:                          // TXIFG0
            if(doingTxInit)
            {
                UCB0TXBUF = txPacket[txIndex];
                txIndex++;
            }
            else
            {
                UCB0TXBUF = START_REG;      // register pointer for read
            }
            break;
        default:
            break;
    }
}

#pragma vector = PORT4_VECTOR
__interrupt void PORT4_ISR(void)
{
    P4IFG &= ~BIT1;
    buttonPressed = 1;
}

//=====================================================
// MAIN
//=====================================================
int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;

    //--- I2C config ---
    UCB0CTLW0 |= UCSWRST;
    UCB0CTLW0 |= UCSSEL__SMCLK;
    UCB0BRW    = 10;
    UCB0CTLW0 |= UCMODE_3;
    UCB0CTLW0 |= UCMST;
    UCB0I2CSA  = 0x0068;
    UCB0CTLW1 |= UCASTP_2;
    P1SEL1 &= ~BIT3; P1SEL0 |= BIT3;   // P1.3 = SCL
    P1SEL1 &= ~BIT2; P1SEL0 |= BIT2;   // P1.2 = SDA

    //--- Button config ---
    P4DIR &= ~BIT1;
    P4REN |=  BIT1;
    P4OUT |=  BIT1;
    P4IES |=  BIT1;
    P4IFG &= ~BIT1;
    P4IE  |=  BIT1;

    PM5CTL0 &= ~LOCKLPM5;
    UCB0CTLW0 &= ~UCSWRST;
    UCB0IE |= UCTXIE0 | UCRXIE0;
    __enable_interrupt();

    //--- Write initial date/time to RTC ---
    UCB0TBCNT = 0x08;
    txIndex    = 0;
    doingTxInit = 1;
    UCB0CTLW0 |= UCTR;
    UCB0CTLW0 |= UCTXSTT;
    while((UCB0IFG & UCSTPIFG) == 0){}
    UCB0IFG &= ~UCSTPIFG;

    //--- Main loop ---
    while(1)
    {
        if(buttonPressed)
        {
            buttonPressed = 0;
            rxIndex = 0;

            // Phase 1: send register pointer
            UCB0TBCNT   = 0x01;
            doingTxInit = 0;
            UCB0CTLW0  |= UCTR;
            UCB0CTLW0  |= UCTXSTT;
            while((UCB0IFG & UCSTPIFG) == 0){}
            UCB0IFG &= ~UCSTPIFG;

            // Phase 2: read 2 bytes (seconds, minutes)
            UCB0TBCNT   = 0x02;
            UCB0CTLW0  &= ~UCTR;
            UCB0CTLW0  |=  UCTXSTT;
            while((UCB0IFG & UCSTPIFG) == 0){}
            UCB0IFG &= ~UCSTPIFG;

            timestamp_seconds = rxBuffer[0];
            timestamp_minutes = rxBuffer[1];
        }
    }

    return 0;
}
