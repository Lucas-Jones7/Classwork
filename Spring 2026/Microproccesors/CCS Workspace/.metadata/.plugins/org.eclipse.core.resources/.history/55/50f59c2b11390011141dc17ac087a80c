//
// Timer Configuration:
//   SMCLK = 1,000,000 Hz
//   ID__4 = divide by 4 = 250,000 Hz
//   TBIDEX__4 = divide by 4 =62,500 Hz
//   CCR0 = 15624 = period = 0.25s
//   (62,500 / 15,625 = 4 Hz = 0.25s period)
//-----------------------------------------------------
#include <msp430.h>

volatile int timerFlag = 0;

int main(void)
{
    int i;

    WDTCTL = WDTPW | WDTHOLD;          // stop watchdog timer

    // config 4 LEDs on P3.0-P3.3 nibble, LSBit starts on
    P3DIR |= BIT0 | BIT1 | BIT2 | BIT3;
    P3OUT &= ~(BIT1 | BIT2 | BIT3);
    P3OUT |= BIT0;                      // LSBit ON

    // config s1
    P4DIR &= ~BIT1;
    P4REN |= BIT1;
    P4OUT |= BIT1;

    // config s2
    P2DIR &= ~BIT3;
    P2REN |= BIT3;
    P2OUT |= BIT3;

    // unlock gpio
    PM5CTL0 &= ~LOCKLPM5;

    // config timer
    TB0CTL   = TBCLR;                   // clear timers and dividers
    TB0CTL  |= TBSSEL__SMCLK;           // clock source SMCLK
    TB0CTL  |= ID__4;                   // divide by 4
    TB0EX0   = TBIDEX__4;               // divide by 4 again
    TB0CCR0  = 15624;                   // CCR0 = 15624 (0.25s)
    TB0CCTL0 = CCIE;                    // enable interrupt

    __enable_interrupt();               // enable maskable interrupts

    // order of led flashing
    unsigned char cw[4]  = {BIT0, BIT1, BIT2, BIT3};
    unsigned char ccw[4] = {BIT3, BIT2, BIT1, BIT0};


// ------------------------------ MAIN LOOP ----------------------------------------
    while(1) {

        // Reset LSBit ON at start of each cycle
        P3OUT = (P3OUT & 0xF0) | BIT0;

        // Wait for s1
        while(1) {
            if((P4IN & BIT1) == 0) {
                for(i = 0; i < 10000; i++){}    // debounce delay
                if((P4IN & BIT1) == 0) break;
            }
        }

        //S1 3 clockwise loops = 12 flashes
        for(i = 0; i < 12; i++) {
            P3OUT = (P3OUT & 0xF0) | cw[i % 4];
            timerFlag = 0;
            TB0CTL |= MC__UP;
            while(timerFlag == 0){}
            TB0CTL &= ~MC__UP;
            TB0CTL |= TBCLR;
        }
        P3OUT = (P3OUT & 0xF0) | BIT0;         // return LSBit ON

        // Wait for S2
        while(1) {
            if((P2IN & BIT3) == 0) {
                for(i = 0; i < 10000; i++){}    // debounce delay
                if((P2IN & BIT3) == 0) break;
            }
        }

        //S2 2 counterclockwise loops = 8 flashes
        for(i = 0; i < 8; i++) {
            P3OUT = (P3OUT & 0xF0) | ccw[i % 4];
            timerFlag = 0;
            TB0CTL |= MC__UP;
            while(timerFlag == 0){}
            TB0CTL &= ~MC__UP;
            TB0CTL |= TBCLR;
        }
        P3OUT = (P3OUT & 0xF0) | BIT0;         // return LSBit ON
    }

    return 0;
}

//-----------------------------------------------------
// Interrupt Service Routines
//-----------------------------------------------------

// Timer B0 CCR0 ISR
#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer_B0_ISR(void) {
    timerFlag = 1;
}
