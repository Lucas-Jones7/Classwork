#include <msp430.h> 

// global variables
volatile unsigned int ADCvalue = 0;
#define OFFSET   15
#define LOW_MAX  (XXX  - OFFSET)    // 1v
#define HIGH_MAX (XXX - OFFSET)    // 2v

int main(void)
{
	WDTCTL = WDTPW | WDTHOLD;	// stop watchdog timer
	
	// configure LEDs
	P1DIR |= BIT0;                  // config LED1 as output
	P1OUT &= ~BIT0;                 // LED1 off to start
	P6DIR |= BIT6;                  // config LED2 as output
	P6OUT &= ~BIT6;                 // LED2 off to start

	// configure P1.4 as ADC input
	P1SEL1 |= BIT4;                 // configure P1.2 to ADC function
	P1SEL0 |= BIT4;
	return 0;
}
