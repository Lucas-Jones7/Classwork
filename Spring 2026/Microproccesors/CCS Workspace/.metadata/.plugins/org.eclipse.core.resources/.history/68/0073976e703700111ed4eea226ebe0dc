#include <msp430.h> 

// global vars (Set to 1:10 April 13th, 2026)
#define START_REG 0x03          // start register
#define SEC 0x00                // seconds 0-59 (0)
#define MIN 0x10                // mins 0-59 (10)
#define HOUR 0x1               // hours 0-23 (1)
#define DAY 0x13                // days 1-31 (13)
#define WEEKDAY 0x03            // day of week 0-6, (3=wed)
#define MONTH 0x04              // months 1-12 (4=april)
#define YEAR 0x26               // year (2026)

int buttonPressed = 0;
int txIndex = 0;
int rxIndex = 0;

//packet array
unsigned char packet[8] = {START_REG, SEC, MIN, HOUR, DAY, WEEKDAY, MONTH, YEAR};


int main(void)
{
	WDTCTL = WDTPW | WDTHOLD;	// stop watchdog timer
	
	// put eUSCI_B0 into software reset
	UCB0CTLW0 |= UCSWRST;

	// config eUSCI_B0
	UCB0CTLW0 |= UCSSEL__SMCLK; // clock source = SMCLK
	UCB0BRW = 10;               // divide by 10 for SCL = 100kHz

	UCB0CTLW0 |= UCMODE_3;      // put into I2C mode
	UCB0CTLW0 |= UCMST;         // put into master mode
	UCB0I2CSA = 0x0068;         // slave address = 0x68 for RTC

	UCB0TBCNT = 0x08;           // send 8 bytes of data
	UCB0CTLW1 |= UCASTP_2;      // auto stop when UCB0TBCNT reached

	// config ports for I2c
	// SCL
	P1SEL1 &= ~BIT3;
	P1SEL0 |= BIT3;             // p1.3 = UCB0SCL

	// SDA
	P1SEL1 &= ~BIT2;
	P1SEL0 |= BIT2;             // p1.2 = UCB0SDA

	// config S1 button (P4.1)
	P4DIR &= ~BIT1;              // P4.1 as input
	P4REN |= BIT1;               // enable pull resistor
	P4OUT |= BIT1;               // pull-up
	P4IES |= BIT1;               // high-to-low edge
	P4IFG &= ~BIT1;              // clear flag
	P4IE  |= BIT1;               // enable interrupt

	PM5CTL0 &= ~LOCKLPM5;       // disable LPM lock

	// take out of SW reset
	UCB0CTLW0 &= ~UCSWRST;

	// enable interrupts
	UCB0IE |= UCTXIE0;          // enable I2C tx IRQQ
	UCB0IE |= UCRXIE0;           // enable I2C Rx IRQ
	__enable_interrupt();       // enable maskable IRQs


// ------------------------ MAIN LOOP ---------------------------
	while(1){
	    txIndex = 0;            // reset packet index before each transmission

	    UCB0CTLW0 |= UCTR;      // put into tx mode
	    UCB0CTLW0 |= UCTXSTT;   // generate start condition

	    while((UCB0IFG & UCSTPIFG) == 0){} // wait for stop condition
	    UCB0IFG &= ~UCSTPIFG;   // clear stop flag

	    // delay before repeating
	    volatile int i;
	    for(i=0; i<30000; i++){}

	    if(buttonPressed){
	        buttonPressed = 0;
	        rxIndex = 0;

	        // Transmit register address with write message
	        UCB0CTLW0 |= UCTR;       // put into Tx mode
	        UCB0CTLW0 |= UCTXSTT;    // generate START condition
	        while((UCB0IFG & UCSTPIFG) == 0){} // wait for STOP
	        UCB0IFG &= ~UCSTPIFG;    // clear STOP flag

	        // read 2 bytes (seconds, minutes)
	        UCB0TBCNT   = 0x02;
	        UCB0CTLW0  &= ~UCTR;
	        UCB0CTLW0  |=  UCTXSTT;
	        while((UCB0IFG & UCSTPIFG) == 0){}
	        UCB0IFG &= ~UCSTPIFG;

	        seconds = rxBuffer[0];
	        minutes = rxBuffer[1];
	    }

	return 0;
}


//-----------------------------------------------------
// Interrupt Service ROutines
//-----------------------------------------------------
// service TXBUF
#pragma vector = EUSCI_B0_VECTOR
__interrupt void EUSCI_B0_ISR(void){
    switch(UCB0IV){
            case 0x16:                          // RXIFG0
                rxBuffer[rxIndex] = UCB0RXBUF;
                rxIndex++;
                break;
            case 0x18:                          // TXIFG0
                if(doingTxInit){
                    UCB0TXBUF = txPacket[txIndex];
                    txIndex++;
                }
                else{
                    UCB0TXBUF = START_REG;      // register pointer for read
                }
                break;
            default:
                break;
        }
}
// ------------------------ END SERVICE TXBUF ----------------------------

// service s1
#pragma vector = PORT4_VECTOR
__interrupt void PORT4_ISR(void){
    P4IFG &= ~BIT1;              // clear S1 flag
    buttonPressed = 1;           // set flag for main loop
}
// ------------------ END SERVICE S1 -------------------------------
