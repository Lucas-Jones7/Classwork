init:
; Lab 8.2 - Step 2: Initialize your code
			bis.b	#BIT0, &P1DIR			; sets P1.0 and P6.6 as outputs with LOW initial state
			bic.b	#BIT0, &P1OUT
			bis.b	#BIT6, &P6DIR
			bic.b	#BIT6, &P6OUT

			mov.b	#00h, &P5SEL0			; set P5.0-P5.3 as inputs with pull donw resistors
			mov.b	#00h, &P5SEL1
			mov.b	#00h, &P5DIR
			bis.b	#0Fh, &P5REN
			bic.b	#0Fh, &P5OUT

			bic.w	#LOCKLPM5, &PM5CTL0		; Disable high-Z option

Main:
			bis.b	#BIT0, &P1OUT			; Red LED on
			mov.w	#0FFFFh, R4

MainDelayOn:
			dec		R4
			jnz		MainDelayOn				; jump if z = 0
			bic.b	#BIT0, &P1OUT
			mov.w	#0FFFFh, R4

MainDelayOff:
			dec		R4
			jnz		MainDelayOff			; jump if z = 0

