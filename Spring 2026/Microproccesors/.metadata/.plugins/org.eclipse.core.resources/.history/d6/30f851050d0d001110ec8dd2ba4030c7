; Lab 8.2 - Step 3: Use an If/Else Statement to allow the input states determine which led flashes
If: 		cmp.b	#001h, &P5IN			; check if P5.0 is high
			jne		ElseIf1					; jump if not equal
			bic.b	#BIT0, &P1OUT			; turn off red
			bis.b	#BIT6, &P6OUT			; green on

IfDelayOn:
			dec		R4
			jnz		IfDelayOn				; jump if z = 0

			bic.b	#BIT6, &P6OUT			; green LED off
			mov.w	#0FFFFh, R4

IfDelayOff:
			dec		R4
			jnz		ForDelayOff				; jump if z = 0

			jmp		EndIf

ElseIf1:
			cmp.b	#002j, &P5IN			; check if P5.0 is high
			jne		ElseIf2					; if not equal jump

			bic.b	#BIT6, &P6OUT			; green off
			bis.b	#BIT0, &P1OUT			;red on
			mov.w	#0FFFFh, R4

ElseIf1DelayOn:
			dec		R4
			jnz		ElseIf1DelayOn				; jump if z = 0

			bic.b	#BIT6, &P6OUT			; green LED off
			mov.w	#0FFFFh, R4

ElseIf1DelayOff:
			dec		R4
			jnz		ElseIf1DelayOff				; jump if z = 0

			jmp		EndIf

ElseIf2:
			cmp.b	#004h, &P5IN				; check if P5.2 is high
			jne		Else						; if not equal jump

			bis.b	#BIT0, &P1OUT				; red on
			bis.b	#BIT6, &P6OUT				; greeen on
			mov.w	#0FFFFh, R4
