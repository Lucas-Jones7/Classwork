;-------------------------------------------------------------------------------
            .cdecls C,LIST,"msp430.h"       ; Include device header file
            
;-------------------------------------------------------------------------------
            .def    RESET                   ; Export program entry-point to
                                            ; make it known to linker.
;-------------------------------------------------------------------------------
            .text                           ; Assemble into program memory.
            .retain                         ; Override ELF conditional linking
                                            ; and retain current section.
            .retainrefs                     ; And retain any sections that have
                                            ; references to current section.

;-------------------------------------------------------------------------------
RESET       mov.w   #__STACK_END,SP         ; Initialize stackpointer
StopWDT     mov.w   #WDTPW|WDTHOLD,&WDTCTL  ; Stop watchdog timer


;-------------------------------------------------------------------------------
; Main loop here
;-------------------------------------------------------------------------------
init:
; Lab 8.2 - Step 2: Initialize your code
			bis.b	#BIT0, &P1DIR			; sets P1.0 and P6.6 as outputs with LOW initial state
			bic.b	#BIT0, &P1OUT
			bis.b	#BIT6, &P6DIR
			bic.b	#BIT6, &P6OUT

			mov.b	#00h, &P5SEL0			; set P5.0-P5.3 as inputs with pull donw resistors
			mov.b	#00h, &P5SEL1
			mov.b	#00h, &P5DIR
			bis.b	#0Fh, &P5REN
			bic.b	#0Fh, &P5OUT

			bic.w	#LOCKLPM5, &PM5CTL0		; Disable high-Z option

; Lab 8.2 - Step 3: Use a while loop to blink LED while input is HIGH
Main:
			bis.b	#BIT0, &P1OUT			; Red LED on
			mov.w	#0FFFFh, R4

While:
			bit.b	#BIT0, &P5IN			; check P5.0
			jz		EndWhile				; if LOW, exit loop

			bis.b	#BIT6, &P6OUT			; Green LED on

WhileDelayOn:
			dec		R4
			jnz		WhileDelayOn

			bic.b	#BIT6, &P6OUT
			mov.w	#0FFFFh, R4

WhileDelayOff:
			dec		R4
			jnz		WhileDelayOff

			jmp 	While

EndWhile:
			jmp		main

;-------------------------------------------------------------------------------
; Stack Pointer definition
;-------------------------------------------------------------------------------
            .global __STACK_END
            .sect   .stack
            
;-------------------------------------------------------------------------------
; Interrupt Vectors
;-------------------------------------------------------------------------------
            .sect   ".reset"                ; MSP430 RESET Vector
            .short  RESET
            
