getwd()
# load packages
library(tidyverse)
library(patchwork)
# read in the data and select variables mentioned above
# also transform drivetrain to a factor
ev_data <- read_csv("electric_vehicles_spec_2025.csv")
# data frame we want to use is now called "df_ev"
df_ev <- ev_data %>%
select(drivetrain, battery_capacity_kWh,
efficiency_wh_per_km, top_speed_kmh,
acceleration_0_100_s, range_km) %>%
mutate(drivetrain = factor(drivetrain))
# Katie fits this slr...
fit_speed <- lm(top_speed_kmh ~ acceleration_0_100_s, data = df_ev)
summary(fit_speed)
confint(fit_speed)
# split plotting window into 4 panels
# Note: to make a 2x2 grid, change c(1,4) to c(2,2)
par(mfrow = c(1,4))
# make diagnostic plots
plot(fit_speed, pch = 19, col = rgb(0.2,0.2,0.2, 0.5))
p1 <- df_ev |>
ggplot(aes(x = acceleration_0_100_s, y = top_speed_kmh)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
labs(title = "A")
p2 <- df_ev |>
ggplot(aes(x = log(acceleration_0_100_s), y = top_speed_kmh)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
labs(title  = "B")
p3 <- df_ev |>
ggplot(aes(x = acceleration_0_100_s, y = log(top_speed_kmh))) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
labs(title = "C")
p4 <- df_ev |>
ggplot(aes(x = log(acceleration_0_100_s), y = log(top_speed_kmh))) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
labs(title = "D")
library(patchwork)
p1 + p2 + p3 + p4
# write code to fit the model you chose in question 6
fit_llspeed <- lm(log(top_speed_kmh) ~ log(acceleration_0_100_s), data = df_ev)
# write code to look at the summary output/conduct a test on the transformed scale
summary(fit_llspeed)
# write code to create a 95% CI on the transformed scale
confint(fit_llspeed)
# write code to back-transform your CI for interpretation on the original scale
# back-transform the slope CI
exp(confint(fit_llspeed)["log(acceleration_0_100_s)", ])
# CI/PI
# 1. range of all acceleration_0_100_s
df_ev |>
dplyr::select(acceleration_0_100_s) |>
range()
# 2. create tibble called "x_new" for range of X var
x_new <- tibble(acceleration_0_100_s = seq(from = 2.2, to = 19.1, length = 100))
x_new
# log-log regression model called fit_llspeed
fit_llspeed <- lm(log(top_speed_kmh) ~ log(acceleration_0_100_s), data = df_ev)
# 3. use predict to get 95% CI and PI
CI <- predict(fit_llspeed, newdata = x_new, interval = "confidence",
level = 0.95)
PI <- predict(fit_llspeed, newdata = x_new, interval = "prediction",
level = 0.95)
df_predict <- tibble(x_new, ci_est = CI[,1], ci_lwr = CI[,2], ci_upr = CI[,3],
pi_est = PI[,1], pi_lwr = PI[,2], pi_upr = PI[,3])
# 4. Back-transform to original scale. The y-variable was logged, so all
# predictions of mu_new and y_new need to be exponentiated! Again,
# this is a different computation than what needs to be done to
# interpret the slope.
df_og_predict <- df_predict |>
mutate(acceleration_0_100_s = acceleration_0_100_s,
ci_est = exp(ci_est), ci_lwr = exp(ci_lwr), ci_upr = exp(ci_upr),
pi_est = exp(pi_est), pi_lwr = exp(pi_lwr), pi_upr = exp(pi_upr))
df_og_predict
# prediction interval bands with specific names
# set up tibble for plotting
# create plot
p1 <- ggplot(df_predict) +
geom_line(aes(x = log(acceleration_0_100_s), y = ci_est), lwd = 1) +
geom_point(data = df_ev,
aes(x = log(acceleration_0_100_s), y = log(top_speed_kmh)),
inherit.aes = F, alpha = 0.5) +
geom_ribbon(aes(x = log(acceleration_0_100_s), ymin = pi_lwr, ymax = pi_upr), alpha = 0.4,
fill = "#BF8699", color = "#830042", lty = 3, lwd = 1) +
geom_ribbon(aes(x = log(acceleration_0_100_s), ymin = ci_lwr, ymax = ci_upr), alpha = 0.4,
fill = "#189BA0", color = "#084D49", lty = 2, lwd = 1) +
theme_bw() +
labs(y = "log(Top Speed) (log-kmh)", x = "log(Acceleration 0 to 100kmh) (log-sec)", title = "95% PI and CI on tranformed scale")
# prediction interval bands with specific names
# set up tibble for plotting
# create plot
p2 <- ggplot(df_og_predict) +
geom_line(aes(x = acceleration_0_100_s, y = ci_est), lwd = 1) +
geom_point(data = df_ev, aes(x = acceleration_0_100_s, y = top_speed_kmh),
alpha = 0.5,
inherit.aes = F) +
geom_ribbon(aes(x = acceleration_0_100_s, ymin = pi_lwr, ymax = pi_upr), alpha = 0.4,
fill = "#BF8699", color = "#830042", lty = 3, lwd = 1) +
geom_ribbon(aes(x = acceleration_0_100_s, ymin = ci_lwr, ymax = ci_upr), alpha = 0.4,
fill = "#189BA0", color = "#084D49", lty = 2, lwd = 1) +
theme_bw() +
labs(y = "Top Speed (kmh)", x = "Acceleration 0 to 100kmh (sec)", title = "95% PI and CI on OG scale")
p1 + p2
par(mfrow = C(2, 2))
par(mfrow = C(2, 2))
par(mfrow = c(2, 2))
plot(fit_llspeed, pch = 19, col = rgb(0.2, 0.2, 0.2, 0.5))
par(mfrow = c(2, 2))
plot(fit_llspeed, pch = 19, col = rgb(0.2, 0.2, 0.2, 0.5))
