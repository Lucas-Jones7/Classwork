for(i in 1:B){
Tstar[i] <- diffmean(Distance ~ shuffle(Condition),
data = df_sub)
}
# summary stats for null dist
favstats(Tstar)
# plot permutation dist
tibble(Tstar) %>% ggplot(aes(x = Tstar)) +
geom_histogram(aes(y = after_stat(ncount)),
bins = 15, col = 1, fill = "skyblue", color = "black",
center = 0) +
