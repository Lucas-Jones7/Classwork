# code to make a subset of data with only
# "casual" and "commute" conditions
df_commute %>%
# keep only observations with Condition = "casual"
# or Condition = "commute"
filter(Condition %in% c("police", "novice")) %>%
# make Condition a factor again to get rid of other
# levels of the factor
mutate(Condition = factor(Condition))
# create a new tibble, called df_sub, with the two
# categories of commute outfit you want to investigate
# change "CATEGORY1" and "CATEGORY2" accordingly.
df_sub <- df_commute %>%
filter(Condition %in% c("police", "novice")) %>%
mutate(Condition = factor(Condition))
df_sub
# code to make a subset of data with only
# "casual" and "commute" conditions
df_commute %>%
# keep only observations with Condition = "casual"
# or Condition = "commute"
filter(Condition %in% c("casual", "commute")) %>%
# make Condition a factor again to get rid of other
# levels of the factor
mutate(Condition = factor(Condition))
# load yarrr
library(yarrr)
pirateplot(Distance ~ Condition, data = df_sub,
inf.method = "ci", inf.disp = "line",
ylab = "Distance (cm)")
# create a new tibble, called df_sub, with the two
# categories of commute outfit you want to investigate
# change "CATEGORY1" and "CATEGORY2" accordingly.
df_sub <- df_commute %>%
filter(Condition %in% c("police", "novice")) %>%
mutate(Condition = factor(Condition))
df_sub
library(mosaic)
# summary statistics
favstats(Distance ~ Condition, data = df_sub)
# observed result
OR <- diffmean(Distance ~ Condition, data = df_sub)
OR
# set # of permutations to run
B <- 1000
# create storage vector
Tstar <- rep(NA, B)
# create 1000 simulated "null differences"
for(i in 1:B){
Tstar[i] <- diffmean(Distance ~ shuffle(Condition),
data = df_sub)
}
# summary stats for null dist
favstats(Tstar)
# plot permutation dist
tibble(Tstar) %>% ggplot(aes(x = Tstar)) +
geom_histogram(aes(y = after_stat(ncount)),
bins = 15, col = 1, fill = "skyblue", color = "black",
center = 0) +
geom_density(aes(y = after_stat(scaled))) +
theme_bw(base_size = 14) +
labs(y = "Density") +
stat_bin(aes(y = after_stat(ncount),
label = after_stat(count)), bins = 15,
geom = "text", vjust = -0.75) +
geom_vline(xintercept = c(-1,1)*OR, col = "red", lwd = 1.5)
