library(tidyverse)
library(mosaic)
library(yarrr)
emissions5 <- read_csv("CO2_emissions_country_groups.csv")
emissions5 <- emissions5 %>% drop_na()
str(emissions5)
favstats(CO2 ~ Country.Code, data = emissions5)
ggplot(emissions5, aes(x = Country.Code, y = CO2, fill = Country.Code)) +
geom_boxplot(alpha = 0.6) +
geom_jitter(width = 0.15, alpha = 0.6) +
labs(title = "CO2 Emissions by Country Group",
x = "Country Group",
y = "CO2 Emissions") +
theme_minimal()
