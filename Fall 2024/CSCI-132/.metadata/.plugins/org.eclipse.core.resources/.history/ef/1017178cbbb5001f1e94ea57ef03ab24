import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class MazeSolver {
    private char[][] maze = new char[12][12];

    public MazeSolver() {
        maze = loadMaze("maze.txt");
    }

    // Part 1: Load maze from file
    public char[][] loadMaze(String filename) {
        char[][] maze = new char[12][12];
        try (Scanner scanner = new Scanner(new File(filename))) {
            for (int i = 0; i < 12; i++) {
                maze[i] = scanner.nextLine().toCharArray();
            }
        } catch (FileNotFoundException e) {
            System.err.println("Maze file not found: " + filename);
            System.exit(1);
        }
        return maze;
    }

    // Part 2: Print maze
    private void print_maze(char[][] maze) {
        for (char[] row : maze) {
            for (char cell : row) {
                System.out.print(cell + " ");
            }
            System.out.println();
        }
        System.out.println();
    }

    // Part 3: Start solving the maze
    public void solveMaze() {
        int start_x = 0;
        int start_y = 2;
        int start_hand_x = 0;
        int start_hand_y = 3;

        make_move(start_x, start_y, start_hand_x, start_hand_y);
    }

    // Part 4: Make a move
    public void make_move(int x, int y, int hand_x, int hand_y) {
        // Mark the current position with 'X'
        maze[y][x] = 'X';
        print_maze(maze);

        // Check if the finish is reached
        if (maze[y][x] == 'F') {
            System.out.println("Exit found! Program ending...");
            return;
        }

        // Determine direction: north, east, south, west
        int direction = 0;
        if (hand_y == y && hand_x > x) direction = 0; // North
        if (hand_y > y && hand_x == x) direction = 1; // East
        if (hand_y == y && hand_x < x) direction = 2; // South
        if (hand_y < y && hand_x == x) direction = 3; // West

        // Calculate potential moves
        int[] move_dx = {0, 1, 0, -1};
        int[] move_dy = {-1, 0, 1, 0};

        int[] hand_dx = {1, 0, -1, 0};
        int[] hand_dy = {0, 1, 0, -1};

        int right_x = x + hand_dx[direction];
        int right_y = y + hand_dy[direction];
        int forward_x = x + move_dx[direction];
        int forward_y = y + move_dy[direction];
        int left_x = x - hand_dx[direction];
        int left_y = y - hand_dy[direction];

        // Move right if possible
        if (maze[right_y][right_x] == '.' || maze[right_y][right_x] == 'F') {
            make_move(right_x, right_y, x, y);
        }
        // Move forward if possible
        else if (maze[forward_y][forward_x] == '.' || maze[forward_y][forward_x] == 'F') {
            make_move(forward_x, forward_y, right_x, right_y);
        }
        // Turn left if stuck
        else {
            make_move(x, y, left_x, left_y);
        }
    }
}
