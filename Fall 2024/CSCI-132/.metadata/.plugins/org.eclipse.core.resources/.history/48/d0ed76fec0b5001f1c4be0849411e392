// You will likely need to import some stuff up here
import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class MazeSolver {
    private char[][] maze = new char[12][12];

    public char[][] loadMaze(String filename) {
    	//PART 1: Read in the maze from a text file into a 2D char array
        try {
            Scanner scanner = new Scanner(new File(filename));
            for (int i = 0; i < 12; i++) {
                maze[i] = scanner.nextLine().toCharArray();
            }
            scanner.close();
        } catch (FileNotFoundException e) {
            System.out.println("File not found: " + filename);
        }
        return maze;
    }

    private void print_maze(char[][] maze) {
    	//PART 2: Print out a 2D character maze
        for (char[] row : maze) {
            for (char c : row) {
                System.out.print(c + " ");
            }
            System.out.println();
        }
        System.out.println(); // Add space between each step
    }

    // Solve the maze
    public void solveMaze() {
        // Find the starting position (the first period on the perimeter)
        int start_x = -1;
        int start_y = -1;

        // Check the top row
        for (int x = 0; x < 12; x++) {
            if (maze[0][x] == '.') {
                start_x = x;
                start_y = 0;
                break;
            }
        }

        // Check the bottom row
        if (start_x == -1) {
            for (int x = 0; x < 12; x++) {
                if (maze[11][x] == '.') {
                    start_x = x;
                    start_y = 11;
                    break;
                }
            }
        }

        // Check the left column
        if (start_x == -1) {
            for (int y = 0; y < 12; y++) {
                if (maze[y][0] == '.') {
                    start_x = 0;
                    start_y = y;
                    break;
                }
            }
        }

        // Check the right column
        if (start_x == -1) {
            for (int y = 0; y < 12; y++) {
                if (maze[y][11] == '.') {
                    start_x = 11;
                    start_y = y;
                    break;
                }
            }
        }

      
        // Start solving the maze
        if (make_move(start_x, start_y)) {
            System.out.println("Exit found! Program ending...");
        } else {
            System.out.println("No solution found.");
        }
    }

    // Recursive method to solve the maze
    public boolean make_move(int x, int y) {
        // Base case: Exit found
        if (maze[y][x] == 'F') {
            print_maze(maze); // Print final maze when exit is found
            return true; // Exit found, end recursion
        }
        // If the current position is a wall (#) or already visited ('X'), return false
        if (maze[y][x] == '#' || maze[y][x] == 'X') {
            return false;
        }
        
        // Mark the current position with an 'X' to indicate it's visited
        maze[y][x] = 'X';
        print_maze(maze); // Print the maze state after marking the current position
        
        // Try moving in the four possible directions: west (left), down, right, up
        // Move west (left) first
        if (x - 1 >= 0 && maze[y][x - 1] != 'X' && make_move(x - 1, y)) {
            return true;
        }
        // Move down
        if (y + 1 < maze.length && maze[y + 1][x] != 'X' && make_move(x, y + 1)) {
            return true;
        }
        // Move right
        if (x + 1 < maze[0].length && maze[y][x + 1] != 'X' && make_move(x + 1, y)) {
            return true;
        }
        // Move up
        if (y - 1 >= 0 && maze[y - 1][x] != 'X' && make_move(x, y - 1)) {
            return true;
        }
        
        // If no move is possible, backtrack: we do not unmark the visited 'X' here
        return false; // Backtrack
    }

    public static void main(String[] args) {
        MazeSolver solver = new MazeSolver();
        solver.loadMaze("maze.txt"); // Provide the correct path to your maze file
        solver.solveMaze();
    }
}


